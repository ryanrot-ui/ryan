; Engine configuration file.
; Jukai No Yami — Sea of Trees Darkness
; Godot 4.3 | GDScript | macOS (Intel) optimized — v2

config_version=5

[application]

config/name="Jukai No Yami"
config/description="Sea of Trees Darkness — A Japanese Folklore Horror Experience"
config/version="1.1.0"
run/main_scene="res://scenes/main/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
